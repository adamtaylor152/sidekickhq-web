    "pg-mem": "^3.0.14",
    "prettier": "3.9.0",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "4.1.10"
