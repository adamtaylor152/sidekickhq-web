    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@tailwindcss/vite": "4.3.2",
