---
import CircleAccent from "@/components/ui/CircleAccent.astro";
import type { SliceProps } from "./slice-types";
import SliceFrame from "./SliceFrame.astro";

type Props = SliceProps;
const { slice, product, industry } = Astro.props;
const media = product?.media ?? industry?.media;
const label = product?.name ?? industry?.name ?? "Sidekick";
---

<SliceFrame slice={slice} eyebrow="See the work" title={`${label}, grounded in a real operating moment`} body={media?.direction ?? "A product view should explain a decision, handoff, or outcome—not float as decoration."} wide>
  <figure class="stage">
    <div class="stage__image">
      {media ? <img src={media.src} alt={media.alt} width="1440" height="960" loading="lazy" /> : <img src="/brand/sidekick-mark-color.svg" alt="" width="640" height="640" loading="lazy" />}
    </div>
    <figcaption>
      <span>Connected operating context</span>
      <p>{product?.workflows[0]?.description ?? industry?.workflows[0]?.description ?? "The customer, work, and result stay connected."}</p>
    </figcaption>
    <CircleAccent size="large" tone="outline" class="stage__circle" />
  </figure>
</SliceFrame>

<style>
  .stage { position: relative; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.5fr); align-items: end; min-height: 38rem; margin: 0; overflow: hidden; border-radius: var(--sk-radius-stage); background: var(--sk-color-navy-950); box-shadow: var(--sk-shadow-stage); color: var(--sk-color-white); }
  .stage__image { align-self: stretch; min-height: 32rem; overflow: hidden; }
  .stage__image img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { position: relative; z-index: 2; display: grid; gap: var(--sk-space-5); padding: var(--sk-space-8); }
  figcaption span { color: var(--sk-color-blue-300); font-size: var(--sk-text-xs); letter-spacing: var(--sk-tracking-wide); text-transform: uppercase; }
  figcaption p { font-family: var(--sk-font-heading); font-size: var(--sk-text-xl); line-height: var(--sk-leading-heading); }
  .stage__circle { position: absolute; right: -7rem; bottom: -8rem; opacity: 0.45; }
  @media (max-width: 50rem) { .stage { grid-template-columns: 1fr; min-height: 0; } .stage__image { min-height: 25rem; } }
</style>
