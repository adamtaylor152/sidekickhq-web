---
import type { SliceProps } from "./slice-types";
import SliceFrame from "./SliceFrame.astro";

type Props = SliceProps;
const { slice, product } = Astro.props;
const faqs = product?.faqs ?? [
  { question: "Can I start with one Sidekick product?", answer: "Yes. Start with the product that solves today's problem and add connected products when the business is ready." },
  { question: "Which products have a trial?", answer: "Eligible software offers include a 30-day trial without a credit card. Voice, Payments, Protect, and hardware do not." },
];
---

<SliceFrame slice={slice} eyebrow="Questions" title="Clear answers before you buy" body="Pricing, trial, hardware, and product boundaries should be understandable before checkout.">
  <div class="faqs">
    {faqs.map((faq, index) => (
      <details open={index === 0}>
        <summary><span>{faq.question}</span><span aria-hidden="true">+</span></summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </div>
</SliceFrame>

<style>
  .faqs { border-top: 1px solid var(--sk-color-line); }
  details { border-bottom: 1px solid var(--sk-color-line); }
  summary { display: flex; justify-content: space-between; gap: var(--sk-space-6); padding-block: var(--sk-space-6); cursor: pointer; font-family: var(--sk-font-heading); font-size: var(--sk-text-xl); font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span:last-child { color: var(--sk-color-blue-500); transition: rotate var(--sk-duration-fast) var(--sk-ease-standard); }
  details[open] summary span:last-child { rotate: 45deg; }
  details p { max-width: 50rem; padding: 0 4rem var(--sk-space-6) 0; color: var(--sk-color-ink-muted); }
  :global(.slice--navy) details, :global(.slice--navy) .faqs { border-color: var(--sk-color-line-dark); }
  :global(.slice--navy) details p { color: rgb(255 255 255 / 60%); }
</style>
