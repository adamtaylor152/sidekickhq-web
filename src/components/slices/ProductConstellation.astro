---
import LinkArrow from "@/components/ui/LinkArrow.astro";
import { PRODUCTS } from "@/content/products";
import type { SliceProps } from "./slice-types";
import SliceFrame from "./SliceFrame.astro";

type Props = SliceProps;
const { slice } = Astro.props;
---

<SliceFrame slice={slice} eyebrow="The Sidekick platform" title="Start with one product. Keep one business." body="Each Sidekick product has enough depth to stand on its own—and a shared record when it needs to work with the rest." wide>
  <div class="constellation">
    {PRODUCTS.map((product, index) => (
      <article class:list={["product", { "product--featured": [0, 3, 4, 8].includes(index) }]}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><p>{product.category}</p><h3>{product.name}</h3><p>{product.tagline}</p></div>
        <LinkArrow href={`/products/${product.slug}`}>Explore</LinkArrow>
      </article>
    ))}
  </div>
</SliceFrame>

<style>
  .constellation { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--sk-color-line); border-left: 1px solid var(--sk-color-line); }
  .product { display: grid; min-height: 19rem; align-content: space-between; gap: var(--sk-space-8); padding: var(--sk-space-6); border-right: 1px solid var(--sk-color-line); border-bottom: 1px solid var(--sk-color-line); background: rgb(255 255 255 / 52%); }
  .product--featured { min-height: 23rem; background: var(--sk-color-white); }
  .product > span { color: var(--sk-color-blue-500); font-family: var(--sk-font-mono); font-size: var(--sk-text-xs); }
  .product div > p:first-child { color: var(--sk-color-ink-muted); font-size: var(--sk-text-xs); text-transform: uppercase; letter-spacing: var(--sk-tracking-wide); }
  h3 { margin-block: var(--sk-space-4); font-size: var(--sk-text-xl); }
  .product div > p:last-child { color: var(--sk-color-ink-muted); font-size: var(--sk-text-sm); }
  @media (max-width: 70rem) { .constellation { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 48rem) { .constellation { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 31rem) { .constellation { grid-template-columns: 1fr; } .product, .product--featured { min-height: 15rem; } }
</style>
