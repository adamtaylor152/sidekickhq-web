---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { PRICE_OFFERS } from "@/content/pricing";

const offerKey = Astro.url.searchParams.get("offer");
const selected = PRICE_OFFERS.find(({ key }) => key === offerKey);
const mode = offerKey?.startsWith("voice.") ? "voice" : offerKey?.startsWith("payments.") ? "payments" : offerKey?.startsWith("protect.") ? "protect" : "software";
---
<SiteLayout title="Get started | Sidekick" description="Start a Sidekick trial or configure service activation, hardware, billing, and account details." canonicalPath="/checkout">
  <section class="checkout-shell sk-section"><div class="sk-container">
    <header><a href="/cart">← Back to cart</a><p class="sk-eyebrow">{mode === "software" ? "30-day trial · no credit card required" : "Guided activation"}</p><h1>{selected ? `${selected.product} ${selected.name}` : "Set up your Sidekick workspace"}</h1><ol><li class="active">Business</li><li>{mode === "voice" ? "Numbers" : mode === "payments" ? "Processing" : "Setup"}</li>{(mode === "voice" || mode === "payments") && <li>Hardware</li>}<li>{mode === "software" ? "Workspace" : "Billing"}</li><li>Review</li></ol></header>
    <form data-checkout-form data-mode={mode}>
      <fieldset data-step="0"><legend>Tell us about the business</legend><div class="fields"><label>Legal business name<input name="businessName" autocomplete="organization" required /></label><label>Operating name<input name="operatingName" autocomplete="organization" /></label><label>Work email<input type="email" name="email" autocomplete="email" required /></label><label>Phone number<input type="tel" name="phone" autocomplete="tel" required /></label><label>Country<select name="country"><option value="CA">Canada</option><option value="US">United States</option></select></label><label>Team size<select name="teamSize"><option>1–5</option><option>6–25</option><option>26–100</option><option>101+</option></select></label></div></fieldset>
      <fieldset data-step="1" hidden><legend>{mode === "voice" ? "Choose new numbers or bring yours" : mode === "payments" ? "Describe how you take payments" : mode === "protect" ? "Choose what needs protection" : "Create the workspace"}</legend>
        {mode === "voice" && <div class="fields"><label>Number plan<select name="numberPlan"><option>Choose new local numbers</option><option>Port existing numbers</option><option>Both</option></select></label><label>Preferred area code<input name="areaCode" inputmode="numeric" maxlength="3" /></label><label>Seats<input name="seats" type="number" min="1" value="1" required /></label><label>Emergency service address<input name="emergencyServiceAddress" autocomplete="street-address" required /></label></div>}
        {mode === "payments" && <div class="fields"><label>Average monthly volume<select name="monthlyVolume"><option>Under $10,000</option><option>$10,000–$50,000</option><option>$50,000–$250,000</option><option>$250,000+</option></select></label><label>Primary channel<select name="primaryChannel"><option>In person</option><option>Online</option><option>Both</option></select></label><label>Business website<input name="businessWebsite" type="url" /></label><label>Industry<input name="industry" /></label></div>}
        {mode === "protect" && <div class="fields"><label>Workstations<input name="workstations" type="number" min="0" value="1" /></label><label>Servers<input name="servers" type="number" min="0" value="0" /></label><label>Cloud users<input name="cloudUsers" type="number" min="0" value="0" /></label></div>}
        {mode === "software" && <div class="fields"><label>Workspace name<input name="workspaceName" required /></label><label>Preferred URL<input name="preferredUrl" placeholder="yourbusiness.sidekickhq.ca" /></label><label>First admin name<input name="adminName" autocomplete="name" required /></label></div>}
      </fieldset>
      {(mode === "voice" || mode === "payments") && <fieldset data-step="2" hidden><legend>{mode === "voice" ? "Add Poly or Yealink phones" : "Add payment terminals"}</legend><p>Hardware is optional. You can add supported devices now and assign or activate them after the order.</p><a class="hardware-link" href={mode === "voice" ? "/products/voice/phones" : "/products/payments/terminals"}>Browse the full hardware catalogue →</a></fieldset>}
      <fieldset data-step={mode === "voice" || mode === "payments" ? "3" : "2"} hidden><legend>{mode === "software" ? "Confirm the trial workspace" : "Billing details"}</legend>{mode === "software" ? <div class="trial-note"><strong>No credit card required.</strong><p>Your 30-day trial starts when the workspace is created. We’ll show pricing before any paid conversion.</p></div> : <><div class="fields"><label>Billing contact<input name="billingContact" autocomplete="name" required /></label><label>Billing address<input name="billingAddress" autocomplete="street-address" required /></label></div><div class="trial-note"><strong>Payment stays secure.</strong><p>After the order is accepted, you’ll continue to a secure payment page. Sidekick never collects or stores raw card credentials in this form.</p></div></>}</fieldset>
      <fieldset data-step={mode === "voice" || mode === "payments" ? "4" : "3"} hidden><legend>Review and submit</legend><div class="review"><h2>{mode === "software" ? "Ready to start the 30-day trial" : "Ready to send this activation order"}</h2><p>{mode === "voice" ? "We’ll validate service details, numbers, emergency addresses, hardware, and billing before activation." : mode === "payments" ? "Merchant review and terminal fulfillment begin after submission." : mode === "protect" ? "Coverage begins after onboarding and device enrollment." : "The workspace will be created without charging a card."}</p></div></fieldset>
      <div class="form-actions"><button type="button" data-prev hidden>Back</button><button type="button" data-next>Continue</button><button type="submit" data-submit hidden>{mode === "software" ? "Start trial" : "Submit order"}</button></div>
    </form>
  </div></section>
  <script is:inline>
    const form = document.querySelector("[data-checkout-form]");
    const steps = [...form.querySelectorAll("fieldset")];
    const next = form.querySelector("[data-next]");
    const prev = form.querySelector("[data-prev]");
    const submit = form.querySelector("[data-submit]");
    const params = new URLSearchParams(location.search);
    const selectedOffer = params.get("offer");
    const selectedHardware = params.get("hardware");
    let index = 0;
    const show = () => { steps.forEach((step, i) => step.hidden = i !== index); prev.hidden = index === 0; next.hidden = index === steps.length - 1; submit.hidden = index !== steps.length - 1; document.querySelectorAll("header ol li").forEach((li, i) => li.classList.toggle("active", i <= index)); window.scrollTo({ top: 0, behavior: "smooth" }); };
    next.addEventListener("click", () => { const fields = [...steps[index].querySelectorAll("input[required],select[required]")]; if (fields.every((field) => field.reportValidity())) { index = Math.min(index + 1, steps.length - 1); show(); } });
    prev.addEventListener("click", () => { index = Math.max(0, index - 1); show(); });
    form.addEventListener("submit", async (event) => {
      event.preventDefault(); submit.disabled = true; submit.textContent = "Submitting…";
      const values = Object.fromEntries(new FormData(form));
      const country = values.country || localStorage.getItem("sidekick-country") || "CA";
      const cart = JSON.parse(localStorage.getItem("sidekick-cart") || "[]");
      const lines = cart.length ? cart.map(({ key, quantity }) => ({ offerKey: key, quantity })) : (selectedOffer ? [{ offerKey: selectedOffer, quantity: 1 }] : []);
      if (selectedHardware && !lines.some(({ offerKey }) => offerKey === selectedHardware)) lines.push({ offerKey:selectedHardware, quantity:1 });
      const orderKind = form.dataset.mode;
      const activation = orderKind === "voice" ? { numberPlan:values.numberPlan, areaCode:values.areaCode, seats:Number(values.seats), emergencyServiceAddress:values.emergencyServiceAddress, billingContact:values.billingContact, billingAddress:values.billingAddress } : orderKind === "payments" ? { monthlyVolume:values.monthlyVolume, primaryChannel:values.primaryChannel, businessWebsite:values.businessWebsite, industry:values.industry, billingContact:values.billingContact, billingAddress:values.billingAddress } : orderKind === "protect" ? { workstations:Number(values.workstations), servers:Number(values.servers), cloudUsers:Number(values.cloudUsers), billingContact:values.billingContact, billingAddress:values.billingAddress } : { workspaceName:values.workspaceName, preferredUrl:values.preferredUrl };
      const payload = { requestKey:`checkout-${crypto.randomUUID()}`, country, currency:country === "CA" ? "CAD" : "USD", orderKind, trialRequested:orderKind === "software", business:{ legalName:values.businessName, adminName:values.adminName || values.billingContact || values.operatingName || values.businessName, email:values.email, phone:values.phone }, activation, lines };
      try {
        const response = await fetch("/api/orders", { method:"POST", headers:{ "content-type":"application/json" }, body:JSON.stringify(payload) });
        const body = await response.json();
        if (!response.ok || !body.ok) throw new Error(body.error?.message || "We could not submit the order.");
        localStorage.removeItem("sidekick-cart");
        form.innerHTML = `<div class="success"><p class="sk-eyebrow">Received</p><h2>We have your Sidekick setup.</h2><p>${orderKind === "software" ? "Check your email for the workspace invitation." : "Check your email to continue to secure payment and activation."}</p><a href="/">Return home</a></div>`;
      } catch (error) {
        submit.disabled = false; submit.textContent = orderKind === "software" ? "Start trial" : "Submit order";
        let notice = form.querySelector("[data-submit-error]");
        if (!notice) { notice = document.createElement("p"); notice.dataset.submitError = ""; notice.className = "submit-error"; form.querySelector(".form-actions").prepend(notice); }
        notice.textContent = error instanceof Error ? error.message : "We could not submit the order.";
      }
    });
  </script>
</SiteLayout>
<style>.checkout-shell{min-height:75vh;background:var(--sk-color-paper)}.checkout-shell>.sk-container{display:grid;grid-template-columns:.42fr .58fr;gap:var(--sk-space-10)}header{display:grid;align-content:start;gap:var(--sk-space-5)}header>a{color:var(--sk-color-blue-600);text-decoration:none}header h1{font-size:var(--sk-text-3xl)}header ol{display:grid;gap:var(--sk-space-3);padding:var(--sk-space-6) 0 0;list-style:none;counter-reset:steps}header li{color:var(--sk-color-ink-muted)}header li::before{display:inline-grid;width:1.8rem;height:1.8rem;margin-right:.7rem;place-items:center;border:1px solid var(--sk-color-line);border-radius:50%;counter-increment:steps;content:counter(steps)}header li.active{color:var(--sk-color-ink);font-weight:600}header li.active::before{border-color:var(--sk-color-blue-500);background:var(--sk-color-blue-500);color:white}form{overflow:hidden;border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white;box-shadow:var(--sk-shadow-soft)}fieldset{min-height:30rem;padding:var(--sk-space-8);border:0}legend{width:100%;padding-bottom:var(--sk-space-7);font-family:var(--sk-font-heading);font-size:var(--sk-text-2xl);font-weight:600}.fields{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sk-space-5)}label{display:grid;gap:var(--sk-space-2);font-size:var(--sk-text-sm);font-weight:600}input,select{width:100%;padding:.85rem 1rem;border:1px solid var(--sk-color-line);border-radius:.6rem;background:white;font-size:1rem}.hardware-link{display:inline-block;margin-top:var(--sk-space-7);color:var(--sk-color-blue-600)}.trial-note,.review{display:grid;gap:var(--sk-space-4);padding:var(--sk-space-7);border-radius:var(--sk-radius-card);background:var(--sk-color-blue-100)}.form-actions{display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--sk-space-3);padding:var(--sk-space-5) var(--sk-space-8);border-top:1px solid var(--sk-color-line)}.form-actions button{padding:.8rem 1.2rem;border:1px solid var(--sk-color-blue-500);border-radius:999px;background:var(--sk-color-blue-500);color:white;cursor:pointer}.form-actions [data-prev]{background:white;color:var(--sk-color-blue-600)}.submit-error{width:100%;color:#a31919}.success{display:grid;gap:var(--sk-space-5);padding:var(--sk-space-10)}.success h2{font-size:var(--sk-text-3xl)}.success a{color:var(--sk-color-blue-600)}@media(max-width:56rem){.checkout-shell>.sk-container{grid-template-columns:1fr}.fields{grid-template-columns:1fr}fieldset{min-height:0}}</style>
