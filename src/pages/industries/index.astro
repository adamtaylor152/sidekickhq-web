---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { INDUSTRIES } from "@/content/industries";
const families = [...new Set(INDUSTRIES.map(({family}) => family))];
---
<SiteLayout title="Industries | Sidekick" description="See how Sidekick products work together for service, field, storefront, professional, regulated, and technology businesses." canonicalPath="/industries">
  <section class="industry-index-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Built around the work</p><h1 class="sk-display">Your industry should shape the website—not sit in a dropdown.</h1><p class="sk-body">Explore the Sidekick product recipe, workflows, roles, and AI actions that fit your kind of business.</p></div></section>
  {families.map((family)=><section class="sk-section"><div class="sk-container"><p class="sk-eyebrow">{family}</p><div class="industry-grid">{INDUSTRIES.filter((industry)=>industry.family===family).map((industry)=><a href={`/industries/${industry.slug}`}><img src={industry.media.src} alt={industry.media.alt} loading="lazy" /><div><h2>{industry.name}</h2><p>{industry.hero.title}</p><span>Explore the workflow →</span></div></a>)}</div></div></section>)}
</SiteLayout>
<style>.industry-index-hero{background:var(--sk-color-navy-950);color:white}.industry-index-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:72rem}.industry-index-hero .sk-body{max-width:50rem;color:rgb(255 255 255 / 68%)}section:nth-of-type(odd):not(:first-child){background:var(--sk-color-paper)}section .sk-eyebrow{margin-bottom:var(--sk-space-6)}.industry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-5)}.industry-grid a{overflow:hidden;border-radius:var(--sk-radius-card);background:white;box-shadow:var(--sk-shadow-soft);text-decoration:none}.industry-grid img{width:100%;aspect-ratio:16/10;object-fit:cover}.industry-grid div{display:grid;gap:var(--sk-space-3);padding:var(--sk-space-6)}.industry-grid h2{font-size:var(--sk-text-xl)}.industry-grid p{color:var(--sk-color-ink-muted);font-size:var(--sk-text-sm)}.industry-grid span{color:var(--sk-color-blue-600);font-size:var(--sk-text-sm);font-weight:600}@media(max-width:60rem){.industry-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:38rem){.industry-grid{grid-template-columns:1fr}}</style>
