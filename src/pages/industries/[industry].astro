---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import { INDUSTRIES } from "@/content/industries";
import { getProduct } from "@/content/products";
export const prerender = true;
export const getStaticPaths = () => INDUSTRIES.map((industry)=>({params:{industry:industry.slug},props:{industry}}));
const { industry } = Astro.props;
const products = industry.productSlugs.map(getProduct).filter(Boolean);
---
<SiteLayout title={industry.seo.title} description={industry.seo.description} canonicalPath={`/industries/${industry.slug}`}>
  <section class="industry-hero"><div class="copy sk-section"><p class="sk-eyebrow">{industry.hero.eyebrow}</p><h1 class="sk-display">{industry.hero.title}</h1><p class="sk-body">{industry.hero.body}</p><Button href={industry.cta.href}>{industry.cta.label}</Button></div><img src={industry.media.src} alt={industry.media.alt} /></section>
  <section class="pain sk-section"><div class="sk-container"><p class="sk-eyebrow">Where the day gets stuck</p><div>{industry.pains.map((pain,index)=><article><span>0{index+1}</span><h2>{pain}</h2></article>)}</div></div></section>
  <section class="recipe sk-section"><div class="sk-container"><p class="sk-eyebrow">Your Sidekick product recipe</p><h2 class="sk-heading">Deep apps, connected around the way this business works.</h2><div class="product-row">{products.map((product)=><a href={`/products/${product!.slug}`}><span>{product!.category}</span><h3>{product!.name}</h3><p>{product!.tagline}</p></a>)}</div></div></section>
  <section class="roles sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Who gets value</p><h2 class="sk-heading">Different roles, one operating record.</h2><p>Sidekick gives each person a focused way into the same customer, work, and financial context.</p></div><ol>{industry.roleExamples.map((example,index)=><li><span>{String(index+1).padStart(2,"0")}</span><strong>{example}</strong></li>)}</ol></div></section>
  <section class="workflows sk-section"><div class="sk-container">{industry.workflows.map((workflow,index)=><article><div><p class="sk-eyebrow">Workflow {index+1}</p><h2>{workflow.title}</h2><p>{workflow.description}</p></div><ol>{workflow.steps.map((step)=><li>{step}</li>)}</ol></article>)}</div></section>
  <section class="ai sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Sidekick AI in the work</p><h2 class="sk-heading">Useful actions, grounded in the operating record.</h2></div><ul>{industry.aiActions.map((action)=><li>{action}</li>)}</ul></div></section>
  {industry.caveat && <aside class="caveat"><div class="sk-container"><strong>Important configuration note</strong><p>{industry.caveat}</p></div></aside>}
  <section class="conversion sk-section"><div class="sk-container"><h2>See Sidekick shaped around {industry.name.toLowerCase()}.</h2><Button href={industry.cta.href} variant="light">{industry.cta.label}</Button></div></section>
</SiteLayout>
<style>.industry-hero{display:grid;grid-template-columns:1fr 1fr;background:var(--sk-color-navy-950);color:white}.industry-hero .copy{display:grid;align-content:center;gap:var(--sk-space-6);padding-inline:max(var(--sk-gutter),calc((100vw - var(--sk-container-page))/2))}.industry-hero .sk-body{color:rgb(255 255 255 / 68%)}.industry-hero img{width:100%;height:100%;min-height:42rem;object-fit:cover}.pain{background:var(--sk-color-paper)}.pain .sk-container>div{display:grid;grid-template-columns:repeat(3,1fr);margin-top:var(--sk-space-6);border-top:1px solid var(--sk-color-line)}.pain article{display:grid;gap:var(--sk-space-6);padding:var(--sk-space-8);border-right:1px solid var(--sk-color-line)}.pain span{color:var(--sk-color-blue-600)}.recipe .sk-container{display:grid;gap:var(--sk-space-7)}.product-row{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-4)}.product-row a{display:grid;gap:var(--sk-space-3);padding:var(--sk-space-6);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);text-decoration:none}.product-row span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs);text-transform:uppercase}.product-row p,.workflows article>div>p:last-child{color:var(--sk-color-ink-muted)}.roles{background:var(--sk-color-paper)}.roles .sk-container{display:grid;grid-template-columns:.42fr .58fr;gap:var(--sk-space-10)}.roles .sk-container>div{display:grid;align-content:start;gap:var(--sk-space-4)}.roles .sk-container>div>p:last-child{color:var(--sk-color-ink-muted);line-height:1.7}.roles ol{display:grid;padding:0;border-top:1px solid var(--sk-color-line);list-style:none}.roles li{display:grid;grid-template-columns:3rem 1fr;gap:var(--sk-space-4);padding:var(--sk-space-5);border-bottom:1px solid var(--sk-color-line);background:white}.roles li span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}.workflows{background:var(--sk-color-navy-950);color:white}.workflows .sk-container{display:grid;gap:var(--sk-space-10)}.workflows article{display:grid;grid-template-columns:.8fr 1.2fr;gap:var(--sk-space-10)}.workflows h2{font-size:var(--sk-text-3xl)}.workflows ol{display:grid;grid-template-columns:repeat(4,1fr);padding:0;counter-reset:steps;list-style:none}.workflows li{padding:var(--sk-space-5);border-top:1px solid var(--sk-color-line-dark);color:rgb(255 255 255 / 70%)}.ai{background:var(--sk-color-blue-600);color:white}.ai .sk-container{display:grid;grid-template-columns:1fr 1fr;gap:var(--sk-space-10)}.ai ul{display:grid;gap:var(--sk-space-4);margin:0}.ai li{font-size:var(--sk-text-xl)}.caveat{padding-block:var(--sk-space-6);background:var(--sk-color-warning-surface)}.caveat .sk-container{display:flex;gap:var(--sk-space-5)}.conversion{background:var(--sk-color-navy-950);color:white}.conversion .sk-container{display:flex;justify-content:space-between;align-items:center}.conversion h2{font-size:var(--sk-text-3xl)}@media(max-width:60rem){.industry-hero{grid-template-columns:1fr}.industry-hero img{min-height:24rem}.product-row{grid-template-columns:repeat(2,1fr)}.roles .sk-container,.workflows article,.ai .sk-container{grid-template-columns:1fr}}@media(max-width:42rem){.pain .sk-container>div,.product-row,.workflows ol{grid-template-columns:1fr}.conversion .sk-container,.caveat .sk-container{align-items:flex-start;flex-direction:column}}</style>
