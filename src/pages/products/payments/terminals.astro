---
import ProductLayout from "@/layouts/ProductLayout.astro";
import Button from "@/components/ui/Button.astro";
import { getProduct } from "@/content/products";
import { TERMINAL_HARDWARE } from "@/content/pricing";
const product = getProduct("payments")!;
const descriptions=["A customer-facing touchscreen for a counter or handheld workflow.","A tactile keypad and touchscreen for a fixed counter.","A compact reader for payment anywhere the work happens."];
const images=["/images/products/payments/hero.webp","/images/products/payments/m425.webp","/images/products/payments/hero.webp"];
const terminals=TERMINAL_HARDWARE.map(([key,name,usd,cad],index)=>({key,name,usd,cad,use:descriptions[index],image:images[index]}));
---
<ProductLayout product={product} activePath="/products/payments/terminals">
  <section class="terminal-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Sidekick payment hardware</p><h1 class="sk-display">Put the right terminal where customers actually pay.</h1><p class="sk-body">Countertop, handheld, and mobile hardware sold at local retail MSRP and configured as part of merchant onboarding.</p></div></section>
  <section class="sk-section"><div class="sk-container terminal-grid">{terminals.map((terminal,index)=><article><img src={terminal.image} alt={`${terminal.name} payment terminal with Sidekick checkout screen`} /><div><p class="sk-eyebrow">{index===0?"Smart terminal":index===1?"Countertop":"Mobile"}</p><h2>{terminal.name}</h2><p>{terminal.use}</p><div data-hardware-usd={terminal.usd} data-hardware-cad={terminal.cad}>Local MSRP</div><Button href={`/checkout?offer=payments.processing&hardware=${terminal.key}`}>Add to merchant setup</Button></div></article>)}</div></section>
</ProductLayout>
<style>.terminal-hero{background:var(--sk-color-navy-950);color:white}.terminal-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:72rem}.terminal-hero .sk-body{max-width:50rem;color:rgb(255 255 255 / 68%)}.terminal-grid{display:grid;gap:var(--sk-space-8)}article{display:grid;grid-template-columns:1.25fr .75fr;gap:var(--sk-space-8);align-items:center;padding:var(--sk-space-7);border-radius:var(--sk-radius-stage);background:var(--sk-color-paper)}article:nth-child(even){direction:rtl}article:nth-child(even)>*{direction:ltr}article img{width:100%;max-height:34rem;object-fit:contain;background:white;border-radius:var(--sk-radius-card)}article>div{display:grid;gap:var(--sk-space-5)}article h2{font-size:var(--sk-text-3xl)}article p:not(.sk-eyebrow){color:var(--sk-color-ink-muted)}@media(max-width:50rem){article{grid-template-columns:1fr}article:nth-child(even){direction:ltr}}</style>
