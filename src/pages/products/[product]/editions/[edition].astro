---
import ProductLayout from "@/layouts/ProductLayout.astro";
import Button from "@/components/ui/Button.astro";
import { EDITIONS } from "@/content/editions";
import { getProduct } from "@/content/products";

export const prerender = true;
export const getStaticPaths = () => EDITIONS.map((edition) => ({ params:{product:edition.productSlug,edition:edition.slug}, props:{edition,product:getProduct(edition.productSlug)!} }));
const { product, edition } = Astro.props;
const siblingEditions = EDITIONS.filter(({ productSlug }) => productSlug === product.slug);
---
<ProductLayout product={product} activePath={`/products/${product.slug}/editions/${edition.slug}`}>
  <section class="edition-hero sk-section"><div class="sk-container hero-layout">
    <div class="hero-copy"><p class="sk-eyebrow">{product.name} · {edition.slug.replaceAll("-"," ")}</p><h1 class="sk-display">{edition.name}</h1><p class="sk-body">{edition.summary}</p><div class="hero-actions"><Button href={`/checkout?offer=${edition.offerKey}`}>{edition.trialEligible ? "Start 30-day trial" : "Configure this plan"}</Button><a href={`/products/${product.slug}/editions`}>Compare every {product.name} option →</a></div></div>
    <aside><p class="sk-eyebrow">Designed for</p><h2>{edition.bestFor}</h2><div class="plan-price" data-price-for={edition.offerKey}>See localized pricing</div><span>{edition.trialEligible ? "30 days · no credit card" : "Guided activation · no software trial"}</span></aside>
  </div></section>

  <section class="plan-change sk-section"><div class="sk-container"><header><p class="sk-eyebrow">What this plan changes</p><h2 class="sk-heading">Enough detail to choose confidently. No feature-wall theatre.</h2></header><div class="change-grid">
    <div class="included"><span>Included</span><ol>{edition.includes.map((item,index)=><li><small>{String(index+1).padStart(2,"0")}</small><strong>{item}</strong></li>)}</ol></div>
    <div class="boundaries"><span>Plan boundaries</span><ul>{edition.limits.map((item)=><li>{item}</li>)}</ul><p>Published catalogue terms and the live checkout remain authoritative for final pricing, limits, and country availability.</p></div>
  </div></div></section>

  <section class="capability-story sk-section"><div class="sk-container"><header><p class="sk-eyebrow">Inside {product.name}</p><h2 class="sk-heading">The plan sits inside a complete product—not a disconnected feature bundle.</h2></header><div class="capability-grid">{product.featureGroups.map((group,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{group.title}</h3><p>{group.description}</p><ul>{group.features.map((feature)=><li>{feature}</li>)}</ul></article>)}</div></div></section>

  <section class="workflow-stage sk-section"><div class="sk-container"><div class="workflow-copy"><p class="sk-eyebrow">A real workflow</p><h2 class="sk-heading">{product.workflows[0].title}</h2><p>{product.workflows[0].description}</p></div><ol>{product.workflows[0].steps.map((step,index)=><li><span>{String(index+1).padStart(2,"0")}</span><strong>{step}</strong></li>)}</ol></div></section>

  <section class="other-plans sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Other {product.name} options</p><h2 class="sk-heading">Move by operational need, not by surprise.</h2></div><nav aria-label={`Other ${product.name} plans`}>{siblingEditions.map((candidate)=><a class:list={{active:candidate.slug===edition.slug}} href={`/products/${product.slug}/editions/${candidate.slug}`}><span>{candidate.name}</span><small>{candidate.slug===edition.slug?"Current plan":"View details"}</small></a>)}</nav></div></section>

  <section class="edition-cta sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Take the next step</p><h2 class="sk-heading">See how {edition.name} fits your operation.</h2></div><Button href={`/checkout?offer=${edition.offerKey}`}>{edition.trialEligible ? "Start the 30-day trial" : "Start guided activation"}</Button></div></section>
</ProductLayout>

<style>
  .edition-hero{background:var(--sk-color-navy-950);color:white}.hero-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--sk-space-10);align-items:end}.hero-copy{display:grid;gap:var(--sk-space-6)}.hero-copy .sk-body{color:rgb(255 255 255 / 68%)}.hero-actions{display:flex;align-items:center;gap:var(--sk-space-5)}.hero-actions>a{font-size:var(--sk-text-sm);text-decoration:none}.edition-hero aside{display:grid;gap:var(--sk-space-5);padding:var(--sk-space-8);border:1px solid rgb(255 255 255 / 18%);border-radius:var(--sk-radius-card);background:var(--sk-color-blue-600)}.edition-hero aside h2{font-size:var(--sk-text-2xl)}.plan-price{font-family:var(--sk-font-heading);font-size:var(--sk-text-2xl);font-weight:600}.edition-hero aside>span{font-size:var(--sk-text-xs);opacity:.7}
  .plan-change{background:white}.plan-change .sk-container>header,.capability-story .sk-container>header{display:grid;max-width:55rem;gap:var(--sk-space-4);margin-bottom:var(--sk-space-8)}.change-grid{display:grid;grid-template-columns:1.2fr .8fr;border-top:1px solid var(--sk-color-line);border-left:1px solid var(--sk-color-line)}.change-grid>div{padding:var(--sk-space-7);border-right:1px solid var(--sk-color-line);border-bottom:1px solid var(--sk-color-line)}.change-grid>div>span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs);font-weight:600;letter-spacing:var(--sk-tracking-wide);text-transform:uppercase}.included ol{display:grid;padding:var(--sk-space-5) 0 0;list-style:none}.included li{display:grid;grid-template-columns:3rem 1fr;gap:var(--sk-space-4);padding:var(--sk-space-4) 0;border-top:1px solid var(--sk-color-line)}.included small{color:var(--sk-color-blue-600)}.boundaries{display:grid;align-content:start;gap:var(--sk-space-5);background:var(--sk-color-paper)}.boundaries ul{display:grid;gap:var(--sk-space-3);padding-left:1.2rem}.boundaries p{color:var(--sk-color-ink-muted);font-size:var(--sk-text-sm);line-height:1.7}
  .capability-story{background:var(--sk-color-paper)}.capability-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sk-space-5)}.capability-grid article{display:grid;gap:var(--sk-space-4);padding:var(--sk-space-8);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white}.capability-grid article>span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}.capability-grid h3{font-size:var(--sk-text-2xl)}.capability-grid p{color:var(--sk-color-ink-muted);line-height:1.7}.capability-grid ul{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sk-space-3);padding:var(--sk-space-5) 0 0;border-top:1px solid var(--sk-color-line);list-style:none}.capability-grid li{position:relative;padding-left:var(--sk-space-4);font-size:var(--sk-text-sm)}.capability-grid li::before{position:absolute;left:0;color:var(--sk-color-blue-500);content:"•"}
  .workflow-stage{background:var(--sk-color-navy-950);color:white}.workflow-stage .sk-container{display:grid;grid-template-columns:.8fr 1.2fr;gap:var(--sk-space-10);align-items:start}.workflow-copy{display:grid;gap:var(--sk-space-4)}.workflow-copy p:last-child{color:rgb(255 255 255 / 65%);line-height:1.7}.workflow-stage ol{display:grid;list-style:none}.workflow-stage li{display:grid;grid-template-columns:4rem 1fr;gap:var(--sk-space-4);padding:var(--sk-space-5);border-top:1px solid var(--sk-color-line-dark)}.workflow-stage li span{color:var(--sk-color-blue-300);font-size:var(--sk-text-xs)}
  .other-plans{background:white}.other-plans .sk-container{display:grid;grid-template-columns:.4fr .6fr;gap:var(--sk-space-10)}.other-plans .sk-container>div{display:grid;align-content:start;gap:var(--sk-space-4)}.other-plans nav{display:grid;border-top:1px solid var(--sk-color-line)}.other-plans nav a{display:flex;justify-content:space-between;gap:var(--sk-space-4);padding:var(--sk-space-5);border-bottom:1px solid var(--sk-color-line);color:var(--sk-color-ink);text-decoration:none}.other-plans nav a:hover,.other-plans nav a.active{background:var(--sk-color-blue-100)}.other-plans nav small{color:var(--sk-color-ink-muted)}
  .edition-cta{background:var(--sk-color-blue-600);color:white}.edition-cta .sk-container{display:flex;align-items:end;justify-content:space-between;gap:var(--sk-space-8)}.edition-cta .sk-container>div{display:grid;gap:var(--sk-space-3)}
  @media(max-width:54rem){.hero-layout,.change-grid,.workflow-stage .sk-container,.other-plans .sk-container{grid-template-columns:1fr}.capability-grid{grid-template-columns:1fr}.edition-cta .sk-container{align-items:start;flex-direction:column}}
  @media(max-width:36rem){.hero-actions{align-items:start;flex-direction:column}.capability-grid ul{grid-template-columns:1fr}}
</style>
