---
import ProductLayout from "@/layouts/ProductLayout.astro";
import Button from "@/components/ui/Button.astro";
import { PRODUCTS } from "@/content/products";

export const prerender = true;
export const getStaticPaths = () => PRODUCTS.flatMap((product) => product.featureGroups.map((featureGroup, groupIndex) => ({ params: { product: product.slug, feature: featureGroup.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-").replaceAll(/(^-|-$)/g, "") }, props: { product, featureGroup, groupIndex } })));
const { product, featureGroup, groupIndex } = Astro.props;
const workflow = product.workflows[groupIndex % product.workflows.length];
const relatedGroup = product.featureGroups[(groupIndex + 1) % product.featureGroups.length];
const relatedSlug = relatedGroup.title.toLowerCase().replaceAll(/[^a-z0-9]+/g,"-").replaceAll(/(^-|-$)/g,"");
---

<ProductLayout product={product} activePath={`/products/${product.slug}#features`}>
  <section class="feature-hero sk-section"><div class="sk-container hero-layout"><div><p class="sk-eyebrow">{product.name} · capability</p><h1 class="sk-display">{featureGroup.title}</h1><p class="sk-body">{featureGroup.description}</p></div><aside><p class="sk-eyebrow">What the business gets</p><ul>{product.outcomes.map((outcome)=><li>{outcome}</li>)}</ul></aside></div></section>

  <section class="feature-ledger sk-section"><div class="sk-container"><header><p class="sk-eyebrow">Inside this capability</p><h2 class="sk-heading">Specific tools, connected to a measurable operating result.</h2></header><div class="feature-list">{featureGroup.features.map((feature,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{feature}</h3><p>{product.outcomes[index % product.outcomes.length]}</p></article>)}</div></div></section>

  <section class="workflow sk-section"><div class="sk-container"><div><p class="sk-eyebrow">How the work moves</p><h2 class="sk-heading">{workflow.title}</h2><p>{workflow.description}</p></div><ol>{workflow.steps.map((step,index)=><li><span>{String(index+1).padStart(2,"0")}</span><strong>{step}</strong></li>)}</ol></div></section>

  <section class="feature-next sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Continue through {product.name}</p><h2 class="sk-heading">{relatedGroup.title}</h2><p>{relatedGroup.description}</p></div><a href={`/products/${product.slug}/features/${relatedSlug}`}>Explore the connected capability →</a></div></section>

  <section class="cta sk-section"><div class="sk-container"><div><p class="sk-eyebrow">See it in your operation</p><h2>Put {featureGroup.title.toLowerCase()} to work with {product.name}.</h2></div><Button href={product.cta.href}>{product.cta.label}</Button></div></section>
</ProductLayout>

<style>
  .feature-hero{background:var(--sk-color-navy-950);color:white}.hero-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--sk-space-10);align-items:end}.hero-layout>div{display:grid;gap:var(--sk-space-6)}.feature-hero .sk-body{color:rgb(255 255 255 / 68%)}.feature-hero aside{display:grid;gap:var(--sk-space-5);padding:var(--sk-space-7);border:1px solid var(--sk-color-line-dark);border-radius:var(--sk-radius-card);background:rgb(255 255 255 / 5%)}.feature-hero aside ul{display:grid;gap:var(--sk-space-4);padding:0;list-style:none}.feature-hero aside li{padding-top:var(--sk-space-4);border-top:1px solid var(--sk-color-line-dark);font-family:var(--sk-font-heading);font-size:var(--sk-text-lg)}
  .feature-ledger{background:white}.feature-ledger header{display:grid;max-width:56rem;gap:var(--sk-space-4);margin-bottom:var(--sk-space-8)}.feature-list{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--sk-color-line);border-left:1px solid var(--sk-color-line)}.feature-list article{display:grid;min-height:20rem;align-content:end;gap:var(--sk-space-5);padding:var(--sk-space-8);border-right:1px solid var(--sk-color-line);border-bottom:1px solid var(--sk-color-line)}.feature-list article span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}.feature-list h3{font-size:var(--sk-text-2xl)}.feature-list p{color:var(--sk-color-ink-muted);line-height:1.7}
  .workflow{background:var(--sk-color-paper)}.workflow .sk-container{display:grid;grid-template-columns:.8fr 1.2fr;gap:var(--sk-space-10)}.workflow .sk-container>div{display:grid;align-content:start;gap:var(--sk-space-4)}.workflow .sk-container>div>p:last-child{color:var(--sk-color-ink-muted);line-height:1.7}.workflow ol{display:grid;padding:0;border-top:1px solid var(--sk-color-line);list-style:none}.workflow li{display:grid;grid-template-columns:3rem 1fr;gap:var(--sk-space-4);padding:var(--sk-space-5);border-bottom:1px solid var(--sk-color-line);background:white}.workflow li span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}
  .feature-next{background:var(--sk-color-blue-600);color:white}.feature-next .sk-container{display:flex;align-items:end;justify-content:space-between;gap:var(--sk-space-10)}.feature-next .sk-container>div{display:grid;max-width:52rem;gap:var(--sk-space-4)}.feature-next a{flex:0 0 auto;font-weight:600;text-decoration:none}
  .cta{background:var(--sk-color-navy-950);color:white}.cta .sk-container{display:flex;align-items:end;justify-content:space-between;gap:var(--sk-space-8)}.cta .sk-container>div{display:grid;gap:var(--sk-space-3)}.cta h2{font-size:var(--sk-text-3xl)}
  @media(max-width:52rem){.hero-layout,.workflow .sk-container{grid-template-columns:1fr}.feature-list{grid-template-columns:1fr}.feature-next .sk-container,.cta .sk-container{align-items:start;flex-direction:column}}
</style>
