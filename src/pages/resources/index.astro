---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { RESOURCE_CATEGORIES } from "@/content/resources";
---
<SiteLayout title="Resources | Sidekick" description="Learn how Sidekick products work together, explore product help paths, and find business resources." canonicalPath="/resources">
  <section class="resource-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Resources</p><h1 class="sk-display">Understand the platform. Then get back to the work.</h1><p class="sk-body">Explore products by the tasks your team needs to complete, not by a generic document library.</p></div></section>
  <section class="sk-section"><div class="sk-container resource-grid">{RESOURCE_CATEGORIES.map((category)=><article><p class="sk-eyebrow">{category.name}</p><h2>{category.description}</h2><ul>{category.children.map((child)=><li><a href={`/products/${child.slug}`}><strong>{child.name}</strong><span>{child.taskAreas.join(" · ")}</span></a></li>)}</ul></article>)}</div></section>
  <section class="help-band sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Already a customer?</p><h2 class="sk-heading">Find the right help path.</h2></div><a href="/help">Open Customer Help Center →</a></div></section>
</SiteLayout>
<style>.resource-hero{background:var(--sk-color-navy-950);color:white}.resource-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:70rem}.resource-hero .sk-body{color:rgb(255 255 255 / 68%)}.resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sk-space-6)}article{display:grid;gap:var(--sk-space-5);padding:var(--sk-space-8);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:var(--sk-color-paper)}article h2{font-size:var(--sk-text-2xl)}ul{display:grid;gap:1px;padding:0;background:var(--sk-color-line);list-style:none}li a{display:grid;gap:.3rem;padding:var(--sk-space-4);background:white;text-decoration:none}li span{color:var(--sk-color-ink-muted);font-size:var(--sk-text-xs)}.help-band{background:var(--sk-color-blue-600);color:white}.help-band .sk-container{display:flex;align-items:end;justify-content:space-between}.help-band a{font-weight:600;text-decoration:none}@media(max-width:48rem){.resource-grid{grid-template-columns:1fr}.help-band .sk-container{align-items:start;flex-direction:column;gap:2rem}}</style>
