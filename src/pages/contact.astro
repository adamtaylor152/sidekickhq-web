---
import SiteLayout from "@/layouts/SiteLayout.astro";
---
<SiteLayout title="Contact Sidekick" description="Talk with Sidekick HQ Inc. about products, activation, hardware, partnerships, or support." canonicalPath="/contact">
  <section class="contact sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Talk with Sidekick</p><h1 class="sk-display">Bring us the business problem, not a perfect software brief.</h1><p class="sk-body">Tell us what you run, where the work gets stuck, and which country you operate in.</p></div><form><label>Name<input autocomplete="name" required /></label><label>Work email<input type="email" autocomplete="email" required /></label><label>Company<input autocomplete="organization" required /></label><label>Country<select><option>Canada</option><option>United States</option></select></label><label class="full">What would you like Sidekick to help with?<textarea rows="6" required></textarea></label><button type="submit">Send message</button></form></div></section>
</SiteLayout>
<style>.contact{min-height:72vh;background:var(--sk-color-paper)}.contact>.sk-container{display:grid;grid-template-columns:.45fr .55fr;gap:var(--sk-space-10)}.contact>.sk-container>div{display:grid;align-content:start;gap:var(--sk-space-6)}form{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--sk-space-5);padding:var(--sk-space-8);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white}label{display:grid;gap:.5rem;font-size:var(--sk-text-sm);font-weight:600}.full{grid-column:1/-1}input,select,textarea{width:100%;padding:.85rem;border:1px solid var(--sk-color-line);border-radius:.6rem;font:inherit}button{grid-column:1/-1;width:max-content;padding:.85rem 1.2rem;border:0;border-radius:999px;background:var(--sk-color-blue-500);color:white;font-weight:600}@media(max-width:52rem){.contact>.sk-container,form{grid-template-columns:1fr}.full,button{grid-column:auto}}</style>
