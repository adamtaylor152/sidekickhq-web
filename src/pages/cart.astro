---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import { PRICE_OFFERS } from "@/content/pricing";
const offerJson=JSON.stringify(PRICE_OFFERS).replaceAll("<","\\u003c");
---
<SiteLayout title="Your cart | Sidekick" description="Review the Sidekick products and hardware selected for your business." canonicalPath="/cart">
  <section class="cart-page sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Your Sidekick order</p><h1 class="sk-display">Build the setup that fits.</h1><p class="sk-body">Software, service activation, and hardware stay together through checkout.</p></div><div class="cart-panel"><div data-cart-lines><p>Your cart is empty.</p></div><div class="cart-summary"><span>Estimated recurring total</span><strong data-cart-total>—</strong><small>Taxes, usage, processing, shipping, and one-time hardware appear before payment.</small><Button href="/checkout">Continue to checkout</Button></div></div></div></section>
  <script is:inline type="application/json" id="sidekick-offers" set:html={offerJson}></script>
  <script is:inline>
    const offers=JSON.parse(document.querySelector("#sidekick-offers").textContent);
    const country=localStorage.getItem("sidekick-country")||"CA";const currency=country==="CA"?"CAD":"USD";const format=(value)=>new Intl.NumberFormat(country==="CA"?"en-CA":"en-US",{style:"currency",currency,maximumFractionDigits:0}).format(value);const local=(usd)=>country==="CA"?Math.round(usd*1.4):usd;
    const cart=JSON.parse(localStorage.getItem("sidekick-cart")||"[]");const root=document.querySelector("[data-cart-lines]");let total=0;
    if(cart.length){root.innerHTML="";cart.forEach((line)=>{const offer=offers.find(({key})=>key===line.key);if(!offer)return;total+=local(offer.usdMonthly)*line.quantity;const el=document.createElement("article");el.innerHTML=`<div><small>${offer.product}</small><h2>${offer.name}</h2><p>${offer.trialEligible?"30-day trial eligible":"Activation or paid service"}</p></div><div><label>Quantity <input type="number" min="1" value="${line.quantity}" data-qty="${line.key}"></label><strong>${format(local(offer.usdMonthly)*line.quantity)}/mo</strong><button data-remove="${line.key}">Remove</button></div>`;root.append(el)});}
    document.querySelector("[data-cart-total]").textContent=format(total)+" / month";
    root.addEventListener("change",(event)=>{const key=event.target.dataset.qty;if(!key)return;const line=cart.find((item)=>item.key===key);line.quantity=Math.max(1,Number(event.target.value));localStorage.setItem("sidekick-cart",JSON.stringify(cart));location.reload()});
    root.addEventListener("click",(event)=>{const key=event.target.dataset.remove;if(!key)return;localStorage.setItem("sidekick-cart",JSON.stringify(cart.filter((item)=>item.key!==key)));location.reload()});
  </script>
</SiteLayout>
<style>.cart-page{min-height:70vh;background:var(--sk-color-paper)}.cart-page>.sk-container{display:grid;grid-template-columns:.4fr .6fr;gap:var(--sk-space-10)}.cart-page>.sk-container>div:first-child{display:grid;align-content:start;gap:var(--sk-space-5);position:sticky;top:8rem;height:max-content}.cart-panel{overflow:hidden;border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white}.cart-panel :global(article){display:flex;justify-content:space-between;gap:var(--sk-space-6);padding:var(--sk-space-6);border-bottom:1px solid var(--sk-color-line)}.cart-panel :global(article>div){display:grid;gap:var(--sk-space-2)}.cart-panel :global(article>div:last-child){justify-items:end}.cart-panel :global(small),.cart-panel :global(p){color:var(--sk-color-ink-muted)}.cart-panel :global(input){width:4rem;padding:.4rem}.cart-panel :global(button){border:0;background:transparent;color:var(--sk-color-blue-600);cursor:pointer}.cart-summary{display:grid;gap:var(--sk-space-4);padding:var(--sk-space-7);background:var(--sk-color-navy-950);color:white}.cart-summary strong{font-size:var(--sk-text-3xl)}.cart-summary small{color:rgb(255 255 255 / 60%)}@media(max-width:52rem){.cart-page>.sk-container{grid-template-columns:1fr}.cart-page>.sk-container>div:first-child{position:static}}</style>
