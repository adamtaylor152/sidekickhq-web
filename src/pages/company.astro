---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
---
<SiteLayout title="Company | Sidekick HQ Inc." description="Sidekick HQ Inc. builds connected business software for teams that want fewer systems and better operating context." canonicalPath="/company">
  <section class="company-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Sidekick HQ Inc.</p><h1 class="sk-display">Business software should feel like a capable teammate.</h1><p class="sk-body">We’re building a connected platform for the customer, operational, financial, communications, commerce, and service work businesses already do.</p></div></section>
  <section class="beliefs sk-section"><div class="sk-container"><article><span>01</span><h2>Depth matters.</h2><p>Each product has to solve its own job properly before integration means anything.</p></article><article><span>02</span><h2>Context compounds.</h2><p>The same customer, work, and financial record should become more useful across the platform.</p></article><article><span>03</span><h2>AI belongs in the workflow.</h2><p>It should help prepare or move real work—with visible permissions, evidence, and handoff.</p></article></div></section>
  <section class="company-cta sk-section"><div class="sk-container"><h2 class="sk-heading">Build the business with a better Sidekick.</h2><Button href="/contact" variant="light">Talk with us</Button></div></section>
</SiteLayout>
<style>.company-hero{background:var(--sk-color-navy-950);color:white}.company-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:72rem}.company-hero .sk-body{max-width:52rem;color:rgb(255 255 255 / 68%)}.beliefs .sk-container{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--sk-color-line)}article{display:grid;min-height:25rem;align-content:end;gap:var(--sk-space-5);padding:var(--sk-space-8);background:white}article span{color:var(--sk-color-blue-600)}article h2{font-size:var(--sk-text-2xl)}article p{color:var(--sk-color-ink-muted)}.company-cta{background:var(--sk-color-blue-600);color:white}.company-cta .sk-container{display:flex;align-items:center;justify-content:space-between}@media(max-width:48rem){.beliefs .sk-container{grid-template-columns:1fr}article{min-height:18rem}.company-cta .sk-container{align-items:flex-start;flex-direction:column;gap:2rem}}</style>
