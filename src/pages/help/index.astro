---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { HELP_CATEGORIES } from "@/content/resources";
---
<SiteLayout title="Customer Help Center | Sidekick" description="Find the right Sidekick help path by product, workflow, and task." canonicalPath="/help">
  <section class="help-hero sk-section">
    <div class="sk-container hero-grid">
      <div class="hero-copy"><p class="sk-eyebrow">Customer Help Center</p><h1 class="sk-display">Start with the product. Narrow to the job.</h1><p class="sk-body">Sidekick covers a lot of ground. This directory keeps help organized in four levels—business area, product, section, and topic—without turning the first page into a wall of articles.</p></div>
      <div class="search-panel"><label for="help-search">What are you trying to do?</label><div class="search-field"><span aria-hidden="true">⌕</span><input id="help-search" type="search" placeholder="Search products, features, and tasks" data-help-search /></div><p>Article content will be added behind these paths as the customer knowledge base is published.</p></div>
    </div>
  </section>

  <nav class="category-rail" aria-label="Help categories"><div class="sk-container">{HELP_CATEGORIES.map((category)=><a href={`#${category.slug}`}><span>{String(category.products.length).padStart(2,"0")}</span>{category.name}</a>)}</div></nav>

  <section class="starting-points sk-section"><div class="sk-container"><div class="section-heading"><p class="sk-eyebrow">Common starting points</p><h2 class="sk-heading">Get to the right part of Sidekick quickly.</h2></div><div class="starter-grid">
    <a href="#communications"><span>01</span><strong>Set up calling, numbers, or phones</strong><small>Voice activation, porting, Poly and Yealink hardware</small></a>
    <a href="#money-commerce"><span>02</span><strong>Take payments or reconcile money</strong><small>Merchant setup, terminals, settlements, finance</small></a>
    <a href="#customer-growth"><span>03</span><strong>Import customers and start selling</strong><small>CRM records, pipelines, automation, Sidekick AI</small></a>
    <a href="#operations"><span>04</span><strong>Configure an operating workflow</strong><small>MSP, rentals, appointments, protection, and sites</small></a>
  </div></div></section>

  <div class="help-directory">
    {HELP_CATEGORIES.map((category, categoryIndex)=><section class:list={["help-category","sk-section",categoryIndex%2===1&&"help-category--paper"]} id={category.slug} data-help-category>
      <div class="sk-container category-layout">
        <header><p class="sk-eyebrow">{String(categoryIndex+1).padStart(2,"0")} · Help area</p><h2 class="sk-heading">{category.name}</h2><p>{category.description}</p><span>{category.products.length} products</span></header>
        <div class="product-help-list">
          {category.products.map((product)=><details data-help-product data-help-slug={product.slug} data-search={`${category.name} ${product.name} ${product.description} ${product.sections.flatMap(({name,topics})=>[name,...topics]).join(" ")}`.toLowerCase()}>
            <summary><span class="product-index">{product.name.split(" ").at(-1)?.slice(0,2).toUpperCase()}</span><span><strong>{product.name}</strong><small>{product.description}</small></span><span class="open-indicator" aria-hidden="true">+</span></summary>
            <div class="product-help-body">
              <div class="section-grid">{product.sections.map((section)=><section><h3>{section.name}</h3><ul>{section.topics.map((topic)=><li>{topic}</li>)}</ul></section>)}</div>
              <div class="product-help-footer"><span>Help articles coming in the Customer Help Center publishing phase.</span><a href={`/products/${product.slug}`}>Explore the {product.name} mini-site →</a></div>
            </div>
          </details>)}
        </div>
      </div>
    </section>)}
  </div>

  <section class="support-band sk-section"><div class="sk-container"><div><p class="sk-eyebrow">Need a person?</p><h2 class="sk-heading">Sales questions and customer support follow different paths.</h2></div><div><a href="/contact">Talk to Sidekick sales →</a><a href="/login">Sign in for customer support →</a></div></div></section>

  <script is:inline>
    const input = document.querySelector("[data-help-search]");
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      document.querySelectorAll("[data-help-category]").forEach((category) => {
        let visible = 0;
        category.querySelectorAll("[data-help-product]").forEach((product) => {
          const matches = !query || product.dataset.search.includes(query);
          product.hidden = !matches;
          if (matches) { visible += 1; if (query) product.open = true; }
        });
        category.hidden = visible === 0;
      });
    });
  </script>
</SiteLayout>

<style>
  .help-hero{background:var(--sk-color-navy-950);color:white}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--sk-space-10);align-items:end}.hero-copy{display:grid;gap:var(--sk-space-6)}.hero-copy .sk-body{color:rgb(255 255 255 / 68%)}.search-panel{display:grid;gap:var(--sk-space-4);padding:var(--sk-space-8);border:1px solid var(--sk-color-line-dark);border-radius:var(--sk-radius-card);background:rgb(255 255 255 / 5%)}.search-panel label{font-family:var(--sk-font-heading);font-size:var(--sk-text-xl);font-weight:600}.search-field{display:flex;align-items:center;gap:var(--sk-space-3);padding:0 var(--sk-space-4);border:1px solid var(--sk-color-blue-400);border-radius:var(--sk-radius-pill);background:white;color:var(--sk-color-ink)}.search-field span{font-size:var(--sk-text-2xl)}.search-field input{width:100%;padding:1rem 0;border:0;outline:0;font:inherit}.search-panel p{color:rgb(255 255 255 / 58%);font-size:var(--sk-text-xs)}
  .category-rail{position:sticky;z-index:20;top:var(--sk-header-height);border-bottom:1px solid var(--sk-color-line);background:white}.category-rail .sk-container{display:flex;overflow-x:auto}.category-rail a{display:flex;flex:1 0 max-content;align-items:center;gap:var(--sk-space-2);padding:var(--sk-space-4);border-right:1px solid var(--sk-color-line);color:var(--sk-color-ink);font-size:var(--sk-text-sm);text-decoration:none}.category-rail a:first-child{border-left:1px solid var(--sk-color-line)}.category-rail a:hover{background:var(--sk-color-blue-100)}.category-rail span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}
  .starting-points{background:white}.section-heading{display:grid;max-width:52rem;gap:var(--sk-space-4);margin-bottom:var(--sk-space-8)}.starter-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--sk-color-line);border-left:1px solid var(--sk-color-line)}.starter-grid a{display:grid;gap:var(--sk-space-4);min-height:13rem;padding:var(--sk-space-6);border-right:1px solid var(--sk-color-line);border-bottom:1px solid var(--sk-color-line);color:var(--sk-color-ink);text-decoration:none}.starter-grid a:hover{background:var(--sk-color-paper)}.starter-grid span{color:var(--sk-color-blue-600);font-size:var(--sk-text-xs)}.starter-grid strong{font-family:var(--sk-font-heading);font-size:var(--sk-text-lg)}.starter-grid small{margin-top:auto;color:var(--sk-color-ink-muted);line-height:1.5}
  .help-category{scroll-margin-top:calc(var(--sk-header-height) + 4rem);background:white}.help-category--paper{background:var(--sk-color-paper)}.category-layout{display:grid;grid-template-columns:.34fr .66fr;gap:var(--sk-space-10)}.category-layout>header{display:grid;align-content:start;gap:var(--sk-space-4);position:sticky;top:calc(var(--sk-header-height) + 6rem);height:max-content}.category-layout>header>p:not(.sk-eyebrow){color:var(--sk-color-ink-muted);line-height:1.7}.category-layout>header>span{width:max-content;padding:var(--sk-space-2) var(--sk-space-3);border-radius:var(--sk-radius-pill);background:var(--sk-color-blue-100);color:var(--sk-color-blue-700);font-size:var(--sk-text-xs)}.product-help-list{display:grid;gap:var(--sk-space-3)}details{border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white}summary{display:grid;grid-template-columns:auto 1fr auto;gap:var(--sk-space-4);align-items:center;padding:var(--sk-space-6);cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}.product-index{display:grid;width:2.8rem;height:2.8rem;place-items:center;border-radius:50%;background:var(--sk-color-navy-950);color:white;font-size:var(--sk-text-xs)}summary>span:nth-child(2){display:grid;gap:var(--sk-space-1)}summary strong{font-family:var(--sk-font-heading);font-size:var(--sk-text-xl)}summary small{color:var(--sk-color-ink-muted)}.open-indicator{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid var(--sk-color-line);border-radius:50%;color:var(--sk-color-blue-600);font-size:var(--sk-text-lg)}details[open] .open-indicator{background:var(--sk-color-blue-600);color:white;transform:rotate(45deg)}.product-help-body{padding:0 var(--sk-space-6) var(--sk-space-6)}.section-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-4);padding-top:var(--sk-space-6);border-top:1px solid var(--sk-color-line)}.section-grid section{padding:var(--sk-space-5);background:var(--sk-color-paper)}.section-grid h3{min-height:3rem;font-size:var(--sk-text-base)}.section-grid ul{display:grid;gap:var(--sk-space-3);padding:var(--sk-space-4) 0 0;list-style:none}.section-grid li{position:relative;padding-left:var(--sk-space-4);color:var(--sk-color-ink-muted);font-size:var(--sk-text-sm)}.section-grid li::before{position:absolute;left:0;color:var(--sk-color-blue-500);content:"•"}.product-help-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--sk-space-5);padding-top:var(--sk-space-5);color:var(--sk-color-ink-muted);font-size:var(--sk-text-xs)}.product-help-footer a{color:var(--sk-color-blue-600);font-weight:600;text-decoration:none}
  .support-band{background:var(--sk-color-blue-600);color:white}.support-band .sk-container{display:flex;align-items:end;justify-content:space-between;gap:var(--sk-space-8)}.support-band .sk-container>div{display:grid;gap:var(--sk-space-3)}.support-band a{font-weight:600;text-decoration:none}
  @media(max-width:64rem){.starter-grid{grid-template-columns:repeat(2,1fr)}.category-layout{grid-template-columns:1fr}.category-layout>header{position:static}.section-grid{grid-template-columns:1fr}}
  @media(max-width:48rem){.hero-grid{grid-template-columns:1fr}.category-rail{position:static}.starter-grid{grid-template-columns:1fr}.support-band .sk-container{align-items:start;flex-direction:column}.product-help-footer{align-items:start;flex-direction:column}}
</style>
