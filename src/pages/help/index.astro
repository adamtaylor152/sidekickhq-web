---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { RESOURCE_CATEGORIES } from "@/content/resources";
---
<SiteLayout title="Customer Help Center | Sidekick" description="Browse Sidekick customer help paths by product and task." canonicalPath="/help">
  <section class="help-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Customer Help Center</p><h1 class="sk-display">What are you trying to get done?</h1><label><span class="sk-sr-only">Search help</span><input type="search" placeholder="Search products and tasks" data-help-search /></label></div></section>
  <section class="sk-section"><div class="sk-container help-grid">{RESOURCE_CATEGORIES.flatMap((category)=>category.children).map((child)=><article data-help-card data-search={`${child.name} ${child.taskAreas.join(" ")}`.toLowerCase()}><h2>{child.name}</h2><ul>{child.taskAreas.map((area)=><li>{area}</li>)}</ul><a href={`/products/${child.slug}`}>Explore {child.name} →</a></article>)}</div></section>
  <script is:inline>const input=document.querySelector("[data-help-search]");input?.addEventListener("input",()=>{const query=input.value.toLowerCase();document.querySelectorAll("[data-help-card]").forEach((card)=>card.hidden=!card.dataset.search.includes(query))});</script>
</SiteLayout>
<style>.help-hero{background:var(--sk-color-navy-950);color:white}.help-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:70rem}.help-hero input{width:min(100%,44rem);padding:1rem 1.2rem;border:1px solid var(--sk-color-line-dark);border-radius:999px;background:rgb(255 255 255 / 8%);color:white;font-size:1rem}.help-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-5)}article{display:grid;gap:var(--sk-space-4);padding:var(--sk-space-7);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card)}article h2{font-size:var(--sk-text-xl)}article ul{display:grid;gap:var(--sk-space-2);padding-left:1.2rem;color:var(--sk-color-ink-muted)}article a{margin-top:auto;color:var(--sk-color-blue-600);text-decoration:none}@media(max-width:58rem){.help-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:36rem){.help-grid{grid-template-columns:1fr}}</style>
