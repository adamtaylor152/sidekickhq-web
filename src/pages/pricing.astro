---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import { PRICE_OFFERS } from "@/content/pricing";
const groups = [...new Set(PRICE_OFFERS.map(({product})=>product))];
---
<SiteLayout title="Pricing | Sidekick" description="Transparent Canada and US pricing for Sidekick products, with two months free on annual software subscriptions." canonicalPath="/pricing">
  <section class="pricing-hero sk-section"><div class="sk-container"><p class="sk-eyebrow">Simple local pricing</p><h1 class="sk-display">Start with what the business needs. Add more without rebuilding the stack.</h1><p class="sk-body">Prices appear in CAD or USD based on your selected country. Annual software subscriptions include two months free.</p><div class="cadence" role="group" aria-label="Billing cadence"><button data-cadence="monthly" aria-pressed="true">Monthly</button><button data-cadence="annual" aria-pressed="false">Annual · 2 months free</button></div></div></section>
  {groups.map((group)=><section class="price-group sk-section" id={PRICE_OFFERS.find(({product})=>product===group)?.key.split(".")[0]}><div class="sk-container"><div class="group-title"><p class="sk-eyebrow">Product pricing</p><h2 class="sk-heading">{group}</h2></div><div class="offers">{PRICE_OFFERS.filter(({product})=>product===group).map((offer)=><article><h3>{offer.name}</h3><div class="price" data-price-for={offer.key}>See local price</div><p>{offer.trialEligible?"30-day trial. No credit card required.":"Activation begins after ordering. No software trial."}</p><Button href={`/checkout?offer=${offer.key}`}>{offer.trialEligible?"Start trial":"Get started"}</Button></article>)}</div></div></section>)}
  <section class="processing sk-section"><div class="sk-container"><p class="sk-eyebrow">Sidekick Payments</p><h2 class="sk-heading">No platform subscription or setup fee.</h2><div><article><strong>2.9% + 30¢</strong><span>Online cards</span></article><article><strong>2.7% + 5¢</strong><span>In-person cards</span></article><article><strong>15¢</strong><span>Interac in Canada</span></article></div><Button href="/checkout?offer=payments.processing">Set up payments</Button></div></section>
</SiteLayout>
<style>.pricing-hero{background:var(--sk-color-navy-950);color:white}.pricing-hero .sk-container{display:grid;gap:var(--sk-space-6);max-width:72rem}.pricing-hero .sk-body{max-width:52rem;color:rgb(255 255 255 / 68%)}.cadence{display:flex;width:max-content;padding:.25rem;border:1px solid var(--sk-color-line-dark);border-radius:999px}.cadence button{padding:.7rem 1rem;border:0;border-radius:999px;background:transparent;color:white;cursor:pointer}.cadence button[aria-pressed="true"]{background:var(--sk-color-blue-500)}.price-group:nth-of-type(odd){background:var(--sk-color-paper)}.price-group .sk-container{display:grid;grid-template-columns:.35fr .65fr;gap:var(--sk-space-10)}.offers{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-4)}.offers article{display:flex;min-height:23rem;flex-direction:column;gap:var(--sk-space-5);padding:var(--sk-space-7);border:1px solid var(--sk-color-line);border-radius:var(--sk-radius-card);background:white}.offers h3{font-size:var(--sk-text-xl)}.offers .price span{font-family:var(--sk-font-heading);font-size:var(--sk-text-3xl);font-weight:600}.offers .price small{display:block;color:var(--sk-color-ink-muted)}.offers p{margin-bottom:auto;color:var(--sk-color-ink-muted);font-size:var(--sk-text-sm)}.processing{background:var(--sk-color-blue-600);color:white}.processing .sk-container{display:grid;gap:var(--sk-space-7)}.processing .sk-container>div{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sk-space-4)}.processing article{display:grid;gap:var(--sk-space-2);padding:var(--sk-space-6);border:1px solid rgb(255 255 255 / 25%);border-radius:var(--sk-radius-card)}.processing strong{font-size:var(--sk-text-2xl)}@media(max-width:64rem){.price-group .sk-container{grid-template-columns:1fr}.offers{grid-template-columns:repeat(2,1fr)}}@media(max-width:42rem){.offers,.processing .sk-container>div{grid-template-columns:1fr}}</style>
